{
  "metadata": {
    "description": "Candidate material property dataset for the long-endurance UAV fuselage selection study.",
    "source": "Ansys Granta EduPack 2024 R1 (version 24.1.1), records read by the team in November 2026. Granta is the only source of material data in this repository.",
    "records": "CFRP, epoxy matrix (isotropic); Aluminum alloys; Magnesium alloys; Polyetheretherketone (PEEK); Polycarbonate (PC); Acrylonitrile butadiene styrene (ABS); GFRP, epoxy matrix (isotropic). Low carbon steel is in granta_filters.json as the reference of the relative cost, not as a candidate.",
    "format": "'granta' holds the [minimum, maximum] range of each property as shown by Granta (the extent of its bubble). The loader derives the representative value (geometric mean = centre of the bubble in log space) as the plain key, and '<key>_min' / '<key>_max' for conservative screening.",
    "estimated": "Granta marks estimated values with an asterisk; they are listed in 'estimated' of each record.",
    "units": {
      "density_kg_m3": "kg/m^3",
      "price_brl_kg": "BRL/kg (Granta currency in this installation)",
      "youngs_modulus_GPa": "GPa",
      "yield_strength_MPa": "MPa (elastic limit)",
      "tensile_strength_MPa": "MPa",
      "fatigue_strength_1e7_MPa": "MPa at 10^7 cycles",
      "fracture_toughness_MPa_m05": "MPa*m^0.5",
      "max_service_temp_C": "deg C",
      "thermal_conductivity_W_mK": "W/(m*C)",
      "cte_microstrain_K": "10^-6 / C",
      "scores": "Qualitative 1 (worst) to 5 (best), team judgement at 50,000 units/year (not Granta data)"
    },
    "not_in_granta_export": "UV resistance and 24 h water absorption were not read; the filters on them are not evaluated until those properties are added (null)."
  },
